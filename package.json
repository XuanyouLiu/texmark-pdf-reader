{
  "name": "texmark-pdf-reader",
  "displayName": "TeXMark PDF Reader",
  "description": "Fast PDF reading with annotations, Auto Save support, and SyncTeX navigation for LaTeX projects.",
  "publisher": "xuanyouliu",
  "icon": "icon.png",
  "author": {
    "name": "Zed Liu"
  },
  "homepage": "https://github.com/XuanyouLiu/texmark-pdf-reader",
  "license": "MIT",
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "pdf",
    "latex",
    "synctex",
    "annotation",
    "autosave",
    "cursor"
  ],
  "repository": {
      "type": "git",
      "url": "https://github.com/XuanyouLiu/texmark-pdf-reader.git"
  },
  "bugs": {
      "url": "https://github.com/XuanyouLiu/texmark-pdf-reader/issues"
  },
  "galleryBanner": {
      "color": "#0f172a",
      "theme": "dark"
  },
  "version": "1.5.9",
  "browser": "./dist/extension.browser.js",
  "main": "./dist/extension.node.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "texmarkPdfReader.PDFEdit",
        "displayName": "TeXMark PDF Reader",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "TeXMark PDF Reader",
      "properties": {
        "texmarkPdfReader.defaultZoomLevel": {
          "type": "string",
          "default": "page-width",
          "enum": [
            "page-width",
            "page-fit",
            "page-height",
            "auto",
            "50%",
            "75%",
            "100%",
            "125%",
            "150%",
            "200%",
            "300%",
            "400%"
          ],
          "description": "The initial zoom level when opening a PDF file."
        },
        "texmarkPdfReader.defaultSpreadMode": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ],
          "description": "Advanced: the initial PDF spread mode. This is used only when default page layout is set to advanced."
        },
        "texmarkPdfReader.defaultPageLayout": {
          "type": "string",
          "default": "single",
          "enum": [
            "single",
            "two-page",
            "advanced"
          ],
          "enumDescriptions": [
            "Show one page at a time.",
            "Show two pages at a time, keeping the first page as a cover page.",
            "Use texmarkPdfReader.defaultSpreadMode directly."
          ],
          "description": "The default page layout when opening a PDF file."
        },
        "texmarkPdfReader.tabBar": {
          "type": "string",
          "default": "never",
          "enum": [
            "always",
            "multiple",
            "never"
          ],
          "description": "Control the visibility of the internal tab bar."
        },
        "texmarkPdfReader.renderBufferSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 4,
          "description": "Number of nearby pages kept rendered around the viewport. Lower values make the current page appear sooner; higher values make fast scrolling smoother."
        },
        "texmarkPdfReader.renderTileSize": {
          "type": "number",
          "default": 1024,
          "enum": [
            768,
            1024,
            1280
          ],
          "description": "Tile size in pixels for PDF page rendering. Larger tiles reduce render task overhead; smaller tiles can feel lighter on low-memory machines."
        }
      }
    },
    "commands": [
      {
        "command": "texmarkPdfReader.forceSave",
        "title": "Save PDF",
        "category": "TeXMark PDF Reader"
      },
      {
        "command": "texmarkPdfReader.synctex",
        "title": "SyncTeX to TeXMark PDF Reader",
        "category": "TeXMark PDF Reader"
      }
    ],
    "keybindings": [
      {
        "command": "texmarkPdfReader.forceSave",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'texmarkPdfReader.PDFEdit'"
      },
      {
        "command": "workbench.action.closeActiveEditor",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeCustomEditorId == 'texmarkPdfReader.PDFEdit'"
      }
    ]
  },
  "scripts": {
    "build": "webpack",
    "package": "sh scripts/package.sh",
    "deploy": "sh scripts/publish.sh",
    "test-web": "vscode-test-web --extensionDevelopmentPath=. .",
    "test-web-headless": "vscode-test-web --extensionDevelopmentPath=. --headless ."
  },
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@embedpdf/svelte-pdf-viewer": "^2.13.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.7.1",
    "css-loader": "^7.1.4",
    "ovsx": "^0.10.10",
    "style-loader": "^4.0.0",
    "svelte": "^5.55.0",
    "svelte-loader": "^3.2.4",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@embedpdf/core": "^2.13.0",
    "@embedpdf/plugin-document-manager": "^2.13.0",
    "@embedpdf/plugin-render": "^2.13.0"
  }
}
